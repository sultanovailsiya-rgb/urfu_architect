<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Upload" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Upload" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Owner" name="Владелец видео">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Metadata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Web" name="Веб-приложение">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveMeta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Processing" name="Сервис обработки видео">
        <bpmn:flowNodeRef>Task_Transcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Preview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storage" name="Хранилище и БД">
        <bpmn:flowNodeRef>Task_StoreFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreMeta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Хочет загрузить видео">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Login" name="Войти в личный кабинет">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PickFile" name="Выбрать файл и начать загрузку">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validate" name="Проверить формат и размер файла">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Файл корректен?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Error" name="Показать сообщение об ошибке">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Accept" name="Принять файл">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StoreFile" name="Сохранить видеофайл в хранилище">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Transcode" name="Транскодировать видео">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Preview" name="Сгенерировать превью">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StoreVideo" name="Записать данные о видео в базу данных">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notify" name="Уведомить владельца об окончании обработки">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Metadata" name="Указать название и описание">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SaveMeta" name="Сохранить название и описание">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StoreMeta" name="Записать метаданные в базу данных">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Publish" name="Опубликовать страницу видео">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Видео доступно зрителям">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Login" targetRef="Task_PickFile" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PickFile" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_5" name="нет" sourceRef="Gateway_Valid" targetRef="Task_Error" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Error" targetRef="Task_PickFile" />
    <bpmn:sequenceFlow id="Flow_7" name="да" sourceRef="Gateway_Valid" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Accept" targetRef="Task_StoreFile" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_StoreFile" targetRef="Task_Transcode" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Transcode" targetRef="Task_Preview" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Preview" targetRef="Task_StoreVideo" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_StoreVideo" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Notify" targetRef="Task_Metadata" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Metadata" targetRef="Task_SaveMeta" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SaveMeta" targetRef="Task_StoreMeta" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_StoreMeta" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Publish" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Upload">
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true">
        <dc:Bounds x="40" y="20" width="2980" height="280" />
        <bpmndi:BPMNLabel><dc:Bounds x="75" y="130" width="120" height="60" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Web_di" bpmnElement="Lane_Web" isHorizontal="true">
