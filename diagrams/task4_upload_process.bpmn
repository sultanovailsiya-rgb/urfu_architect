      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish">
        <dc:Bounds x="2650" y="330" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Transcode_di" bpmnElement="Task_Transcode">
        <dc:Bounds x="1360" y="610" width="180" height="80" />
