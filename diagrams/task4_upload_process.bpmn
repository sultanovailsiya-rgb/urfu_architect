      <bpmndi:BPMNShape id="Task_Preview_di" bpmnElement="Task_Preview">
        <dc:Bounds x="1570" y="610" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StoreFile_di" bpmnElement="Task_StoreFile">
        <dc:Bounds x="1195" y="810" width="190" height="80" />
